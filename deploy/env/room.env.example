# room_service environment — Gemini LLM fallback (WI-027).
#
# Copy to deploy/env/room.env and fill in ON THE EVENT HOST.
# deploy/env/*.env is gitignored (deploy/env/.gitignore) — never commit it.
#
# Verify blind, never print values (W-083/W-149):
#   [ -f deploy/env/room.env ] && echo exists
#   grep -q '^GEMINI_API_KEY=' deploy/env/room.env && echo key-present
#   chmod 600 deploy/env/room.env

# OPTIONAL — Google Gemini API key. When set, generation falls back to
# Gemini if the primary (Berget via dart_services) fails, and the admin
# provider picker can force Gemini live. When unset, the service runs
# Berget-only exactly as before (the picker reports gemini unavailable).
GEMINI_API_KEY=

# OPTIONAL — Gemini model override (default shown).
# gemini-2.5-flash is EOL for NEW Google accounts (HTTP 404
# "no longer available to new users" — verified 2026-09-09), so the code
# default is gemini-3.6-flash. Only set this to override the default.
#GEMINI_MODEL=gemini-3.6-flash

# OPTIONAL — Gemini thinking budget in tokens (default shown: 512, measured
# fastest END-TO-END on 2026-09-09: ~8.4s generation + first-try compile;
# the model default (field omitted) was ~96s of thinking). Unset/invalid →
# 512. Lower budgets (e.g. 128) generate faster (~5.3s) but produced
# not-quite-compiling code (one auto-fix round-trip). 0 requests
# thinking-off but the API currently 400s it for gemini-3.6-flash.
#GEMINI_THINKING_BUDGET=512

# OPTIONAL — Gemini REST base override (default shown).
# Local rehearsal against a mock, or a proxy; empty/unset → the real API.
#GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
